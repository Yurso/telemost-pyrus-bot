# Токен бота: admin.yandex.ru -> Боты (Яндекс 360)
YANDEX_BOT_TOKEN=
# Pyrus: логин бота и секретный ключ (Настройки -> Боты / API)
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
# Кто может пересылать боту сообщения (через запятую). Пусто = все.
ALLOWED_LOGINS=me@company.ru
# Если пусто — создаётся простая задача. Иначе — задача по форме сервис-деска:
PYRUS_FORM_ID=
PYRUS_FIELD_SUBJECT=Тема
PYRUS_FIELD_TEXT=Описание
PYRUS_FIELD_INITIATOR=Инициатор
